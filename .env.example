# GEMINI_API_KEY: Required for Gemma 4 AI API calls via @google/genai SDK.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Google AI Studio console.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MAKE_WEBHOOK_URL: Optional private webhook endpoint for Make.com / Integromat automation.
# When provided, Commitment OS automatically dispatches analyzed commitments to this webhook.
# Set this in your Render Dashboard (Environment) or local .env. (Do not commit secrets).
# MAKE_WEBHOOK_URL="https://hook.eu1.make.com/your-custom-webhook-id"

# GEMMA_MODEL: Model identifier for Gemma 4 (defaults to 'gemma-4-26b-a4b-it')
GEMMA_MODEL="gemma-4-26b-a4b-it"

# PORT: Server port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
